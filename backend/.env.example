# Copy to .env (git-ignored) or set in your shell / deployment environment.
# Full URL of the hosted Item data API (already URL-encoded if it carries a query string).
EXTERNAL_API_URL=https://enterprise.ztwo.app/api/v1/platform/core/query-config-v2/execute?page=0&size=25
# Graph traversal endpoint used by the Item Hierarchy tab (same host and token).
EXTERNAL_API_GRAPH_URL=https://enterprise.ztwo.app/api/v1/platform/core/graph/match/execute
# Single-object endpoint used by the item details Overview tab (object id is appended).
EXTERNAL_API_OBJECT_URL=https://enterprise.ztwo.app/api/v1/platform/core/objects/partial
# Bearer token for the hosted API. Secret: never commit a real value.
EXTERNAL_API_TOKEN=
# Optional
EXTERNAL_API_CONNECT_TIMEOUT=5s
EXTERNAL_API_READ_TIMEOUT=30s

# DigiKey integration (independent of the Enterprise token). Fill in from your DigiKey app.
DIGIKEY_BASE_URL=https://api.digikey.com
DIGIKEY_CLIENT_ID=
DIGIKEY_CLIENT_SECRET=
DIGIKEY_LOCALE_SITE=IN
DIGIKEY_LOCALE_LANGUAGE=en
DIGIKEY_LOCALE_CURRENCY=INR
DIGIKEY_DEFAULT_KEYWORD=resistor
