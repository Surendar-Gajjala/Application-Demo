# Frontend environment for the Sites view's direct Enterprise API integration.
# Copy to `.env` (git-ignored) and fill in the token. Keep the token in sync with
# backend/.env EXTERNAL_API_TOKEN (same hosted token, ~24h expiry, same data environment).

# Same-origin base path the browser calls; the Vite dev proxy forwards it to the hosted
# server. Leave as-is for local dev.
VITE_ENTERPRISE_API_BASE_URL=/enterprise

# Bearer token for the hosted server. Read ONLY by the Vite dev proxy (Node side) and
# injected as the Authorization header — it is NOT prefixed with VITE_, so it never enters
# the browser bundle. Never commit a real value.
ENTERPRISE_API_TOKEN=
